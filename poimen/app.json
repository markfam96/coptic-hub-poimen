{
  "expo": {
    "name": "Nepsis",
    "slug": "poimen",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "poimen",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1f3d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coptic.poimen",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
      "CFBundleLocalizations": ["en", "ar"],
        "NSFaceIDUsageDescription": "Nepsis uses Face ID to keep your pastoral and confession data private after sign-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f1f3d"
      },
      "package": "com.coptic.poimen",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nepsis uses your location only to list the churches nearest you first. It stays on your phone and is never sent or saved.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Poimen uses your photo library so you can choose a profile picture.",
          "cameraPermission": "Poimen uses the camera so you can take a profile picture."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Poimen adds confirmed appointments to your calendar so times booked here are blocked on Calendly and anywhere else that reads it."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c9a84c",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6557a462-5807-40e8-b87a-b14a70ac5a95"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6557a462-5807-40e8-b87a-b14a70ac5a95"
    }
  }
}
